{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:main": "VITE_BUILD_TARGET=main vite --mode main",
    "dev:maintenance": "VITE_BUILD_TARGET=maintenance vite --mode maintenance",
    "build": "tsc --noEmit && npm run build:main && npm run build:maintenance",
    "build:main": "VITE_BUILD_TARGET=main vite build --mode main",
    "build:maintenance": "VITE_BUILD_TARGET=maintenance vite build --mode maintenance",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "favicons": "node scripts/favicons/generate.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8"
  }
}
